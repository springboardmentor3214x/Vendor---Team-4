# =============================================================================
# Vendor Reliability Intelligence Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values accordingly.

# ---- Application ----
APP_NAME="Vendor Reliability Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=true

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrip_db

# ---- JWT ----
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---- Redis (Optional - for token blacklisting) ----
REDIS_URL=redis://localhost:6379/0

# ---- Email / SMTP (Optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_NAME="VRIP Platform"

# ---- Default Admin ----
DEFAULT_ADMIN_EMAIL=admin@vrip.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_FIRST_NAME=System
DEFAULT_ADMIN_LAST_NAME=Administrator
